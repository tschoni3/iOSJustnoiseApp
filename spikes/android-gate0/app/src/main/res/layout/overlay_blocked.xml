<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clickable="true"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/overlayZapArtwork"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/zap_button"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/shield_title"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlayMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/shield_message_fallback"
        android:textColor="@color/text_secondary"
        android:textSize="20sp" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/openJustnoiseButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/action_background"
        android:text="@string/shield_open_justnoise"
        android:textAllCaps="false"
        android:textColor="@color/action_label" />

</LinearLayout>
</ScrollView>
