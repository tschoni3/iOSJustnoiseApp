    "%@ • %@": {
      "comment": "A subtitle line for a schedule, showing both the mode name and the scheduled time. The first argument is the mode name. The second argument is the formatted time.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ • %2$@"
          }
        }
      }
    },
    "%@ of protected attention": {
      "comment": "A title and a number that displays the total duration of protected attention for the week. The argument is the string “%1$argh %2$argm” or the string “%argm”.",
      "isCommentAutoGenerated": true
    },
    "%@ Protected": {
      "comment": "A label displaying the duration of time the user has been in a protected state. The argument is the duration in minutes.",
      "isCommentAutoGenerated": true
    },
    "%lld": {
      "comment": "A badge displaying a number. The number is either the provided count or \"9+\" if the count is 10 or more.",
      "isCommentAutoGenerated": true
    },
