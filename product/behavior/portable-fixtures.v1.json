{
  "schemaVersion": 1,
  "fixtureSetVersion": "1.4.0",
  "description": "Framework-neutral examples that both native clients must exercise in domain tests.",
  "targetSelectionValidity": [
    {
      "id": "empty",
      "applicationCount": 0,
      "categoryCount": 0,
      "websiteCount": 0,
      "expectedValid": false
    },
    {
      "id": "application-only",
      "applicationCount": 1,
      "categoryCount": 0,
      "websiteCount": 0,
      "expectedValid": true
    },
    {
      "id": "category-only",
      "applicationCount": 0,
      "categoryCount": 1,
      "websiteCount": 0,
      "expectedValid": true
    },
    {
      "id": "website-only",
      "applicationCount": 0,
      "categoryCount": 0,
      "websiteCount": 1,
      "expectedValid": true
    },
    {
      "id": "mixed",
      "applicationCount": 2,
      "categoryCount": 1,
      "websiteCount": 3,
      "expectedValid": true
    }
  ],
  "accidentalStopGuard": {
    "minimumElapsedMilliseconds": 3000,
    "cases": [
      {
        "id": "start",
        "elapsedMilliseconds": 0,
        "expectedStopAllowed": false
      },
      {
        "id": "just-before-threshold",
        "elapsedMilliseconds": 2999,
        "expectedStopAllowed": false
      },
      {
        "id": "at-threshold",
        "elapsedMilliseconds": 3000,
        "expectedStopAllowed": true
      },
      {
        "id": "after-threshold",
        "elapsedMilliseconds": 3001,
        "expectedStopAllowed": true
      }
    ]
  },
  "shieldMessageRendering": [
    {
      "id": "application-name",
      "displayName": "Forest",
      "fallbackCopyKey": "shield.application.fallbackName",
      "expectedMessage": "Forest is currently Zapped.\nTap your Zap to access it."
    },
    {
      "id": "blank-application-name",
      "displayName": "   ",
      "fallbackCopyKey": "shield.application.fallbackName",
      "expectedMessage": "This app is currently Zapped.\nTap your Zap to access it."
    },
    {
      "id": "blank-website-name",
      "displayName": "",
      "fallbackCopyKey": "shield.website.fallbackName",
      "expectedMessage": "This website is currently Zapped.\nTap your Zap to access it."
    }
  ],
  "zapReadHandling": [
    {
      "id": "authorized-first-read",
      "payloadClassification": "authorized",
      "acceptedReadAlreadyHandled": false,
      "expectedOutcome": "accepted",
      "expectedMutationEligible": true
    },
    {
      "id": "authorized-duplicate-read",
      "payloadClassification": "authorized",
      "acceptedReadAlreadyHandled": true,
      "expectedOutcome": "duplicateIgnored",
      "expectedMutationEligible": false
    },
    {
      "id": "unauthorized-read",
      "payloadClassification": "unauthorized",
      "acceptedReadAlreadyHandled": false,
      "expectedOutcome": "unauthorized",
      "expectedMutationEligible": false
    },
    {
      "id": "malformed-read",
      "payloadClassification": "malformed",
      "acceptedReadAlreadyHandled": false,
      "expectedOutcome": "invalid",
      "expectedMutationEligible": false
    },
    {
      "id": "canceled-read",
      "payloadClassification": "canceled",
      "acceptedReadAlreadyHandled": false,
      "expectedOutcome": "canceled",
      "expectedMutationEligible": false
    }
  ],
  "zapEntryModeResolution": [
    {
      "id": "active-stops-without-recent-mode",
      "sessionActive": true,
      "recentModeExists": false,
      "recentModeSelectionValid": false,
      "expectedAction": "stopActiveSession"
    },
    {
      "id": "idle-starts-valid-recent-mode",
      "sessionActive": false,
      "recentModeExists": true,
      "recentModeSelectionValid": true,
      "expectedAction": "startRecentMode"
    },
    {
      "id": "idle-without-recent-mode-fails",
      "sessionActive": false,
      "recentModeExists": false,
      "recentModeSelectionValid": false,
      "expectedAction": "modeUnavailable"
    },
    {
      "id": "idle-with-empty-recent-mode-fails",
      "sessionActive": false,
      "recentModeExists": true,
      "recentModeSelectionValid": false,
      "expectedAction": "modeUnavailable"
    }
  ],
  "sessionLifecycle": [
    {
      "id": "authorized-idle-start",
      "priorState": "idle",
      "readOutcome": "accepted",
      "selectionValid": true,
      "capability": "available",
      "elapsedMilliseconds": 0,
      "expectedTransition": "start",
      "expectedState": "active",
      "expectedRestrictionAction": "apply"
    },
    {
      "id": "missing-selection-start-fails",
      "priorState": "idle",
      "readOutcome": "accepted",
      "selectionValid": false,
      "capability": "available",
      "elapsedMilliseconds": 0,
      "expectedTransition": "startFailed",
      "expectedState": "failed",
      "expectedRestrictionAction": "none"
    },
    {
      "id": "permission-denied-start-fails",
      "priorState": "idle",
      "readOutcome": "accepted",
      "selectionValid": true,
      "capability": "permissionDenied",
      "elapsedMilliseconds": 0,
      "expectedTransition": "startFailed",
      "expectedState": "failed",
      "expectedRestrictionAction": "none"
    },
    {
      "id": "unauthorized-idle-no-change",
      "priorState": "idle",
      "readOutcome": "unauthorized",
      "selectionValid": true,
      "capability": "available",
      "elapsedMilliseconds": 0,
      "expectedTransition": "noChange",
      "expectedState": "idle",
      "expectedRestrictionAction": "none"
    },
    {
      "id": "authorized-active-too-early",
      "priorState": "active",
      "readOutcome": "accepted",
      "selectionValid": true,
      "capability": "available",
      "elapsedMilliseconds": 2999,
      "expectedTransition": "stopRejected",
      "expectedState": "active",
      "expectedRestrictionAction": "none"
    },
    {
      "id": "authorized-active-stop",
      "priorState": "active",
      "readOutcome": "accepted",
      "selectionValid": true,
      "capability": "available",
      "elapsedMilliseconds": 3000,
      "expectedTransition": "stop",
      "expectedState": "idle",
      "expectedRestrictionAction": "clear"
    },
    {
      "id": "duplicate-active-no-change",
      "priorState": "active",
      "readOutcome": "duplicateIgnored",
      "selectionValid": true,
      "capability": "available",
      "elapsedMilliseconds": 3000,
      "expectedTransition": "noChange",
      "expectedState": "active",
      "expectedRestrictionAction": "none"
    }
  ],
  "scheduleEligibility": [
    {
      "id": "eligible-one-time",
      "isEnabled": true,
      "modeResolvable": true,
      "targetSelectionValid": true,
      "repeatWeekdays": [],
      "expectedKind": "oneTime",
      "expectedEligible": true,
      "expectedReason": "eligible"
    },
    {
      "id": "eligible-repeating",
      "isEnabled": true,
      "modeResolvable": true,
      "targetSelectionValid": true,
      "repeatWeekdays": ["monday", "wednesday"],
      "expectedKind": "repeating",
      "expectedEligible": true,
      "expectedReason": "eligible"
    },
    {
      "id": "disabled-repeating",
      "isEnabled": false,
      "modeResolvable": true,
      "targetSelectionValid": true,
      "repeatWeekdays": ["friday"],
      "expectedKind": "repeating",
      "expectedEligible": false,
      "expectedReason": "disabled"
    },
    {
      "id": "unresolved-mode",
      "isEnabled": true,
      "modeResolvable": false,
      "targetSelectionValid": true,
      "repeatWeekdays": [],
      "expectedKind": "oneTime",
      "expectedEligible": false,
      "expectedReason": "modeUnavailable"
    },
    {
      "id": "empty-target-selection",
      "isEnabled": true,
      "modeResolvable": true,
      "targetSelectionValid": false,
      "repeatWeekdays": ["sunday"],
      "expectedKind": "repeating",
      "expectedEligible": false,
      "expectedReason": "targetSelectionEmpty"
    }
  ],
  "historyPresentation": {
    "densityThresholdSeconds": {
      "light": 900,
      "medium": 7200,
      "dense": 21600
    },
    "densityCases": [
      {
        "id": "zero-is-empty",
        "totalSeconds": 0,
        "expectedDensity": "empty"
      },
      {
        "id": "before-light",
        "totalSeconds": 899,
        "expectedDensity": "empty"
      },
      {
        "id": "at-light",
        "totalSeconds": 900,
        "expectedDensity": "light"
      },
      {
        "id": "before-medium",
        "totalSeconds": 7199,
        "expectedDensity": "light"
      },
      {
        "id": "at-medium",
        "totalSeconds": 7200,
        "expectedDensity": "medium"
      },
      {
        "id": "before-dense",
        "totalSeconds": 21599,
        "expectedDensity": "medium"
      },
      {
        "id": "at-dense",
        "totalSeconds": 21600,
        "expectedDensity": "dense"
      },
      {
        "id": "above-dense",
        "totalSeconds": 43200,
        "expectedDensity": "dense"
      }
    ],
    "durationLabelCases": [
      {
        "id": "zero-summary",
        "totalSeconds": 0,
        "style": "summary",
        "expectedLabel": "0m"
      },
      {
        "id": "subminute-summary",
        "totalSeconds": 59,
        "style": "summary",
        "expectedLabel": "0m"
      },
      {
        "id": "subminute-day-detail",
        "totalSeconds": 59,
        "style": "dayDetail",
        "expectedLabel": "<1m"
      },
      {
        "id": "minute-boundary",
        "totalSeconds": 60,
        "style": "dayDetail",
        "expectedLabel": "1m"
      },
      {
        "id": "hour-only",
        "totalSeconds": 3600,
        "style": "summary",
        "expectedLabel": "1h"
      },
      {
        "id": "hour-and-minutes",
        "totalSeconds": 3900,
        "style": "summary",
        "expectedLabel": "1h 5m"
      },
      {
        "id": "multiple-hours-day-detail",
        "totalSeconds": 15180,
        "style": "dayDetail",
        "expectedLabel": "4h 13m"
      }
    ],
    "summaryCases": [
      {
        "id": "empty-history",
        "durationSeconds": [],
        "expectedZapCount": 0,
        "expectedTotalSeconds": 0,
        "expectedProtectedAttentionLabel": "0m"
      },
      {
        "id": "aggregate-before-minute-truncation",
        "durationSeconds": [30, 30],
        "expectedZapCount": 2,
        "expectedTotalSeconds": 60,
        "expectedProtectedAttentionLabel": "1m"
      },
      {
        "id": "mixed-hour-summary",
        "durationSeconds": [900, 1800, 3600],
        "expectedZapCount": 3,
        "expectedTotalSeconds": 6300,
        "expectedProtectedAttentionLabel": "1h 45m"
      }
    ]
  },
  "weekdayIdentifiers": {
    "monday": "Monday",
    "tuesday": "Tuesday",
    "wednesday": "Wednesday",
    "thursday": "Thursday",
    "friday": "Friday",
    "saturday": "Saturday",
    "sunday": "Sunday"
  }
}
